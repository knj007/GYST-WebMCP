  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p workers/reminders/tsconfig.json",
